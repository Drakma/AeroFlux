{
  "multipart": [
    {
      "apply": {
        "model": "aeroflux:block/pipe_part_0",
        "uvlock": true
      }
    },
    {
      "when": {
        "north": "on"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_1",
        "uvlock": true
      }
    },
    {
      "when": {
        "north": "connected"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_2",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "on"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_3",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "connected"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_4",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "on"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_5",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "connected"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_6",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "on"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_7",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "connected"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_8",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": "on"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_9",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": "connected"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_10",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": "on"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_11",
        "x": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": "connected"
      },
      "apply": {
        "model": "aeroflux:block/pipe_part_12",
        "x": 90,
        "uvlock": true
      }
    }
  ]
}